# Copie ce fichier en tools/r2.env et remplis les valeurs.
# tools/r2.env est ignore par git : tes cles ne partiront pas sur GitHub.
#
# Ou les trouver :
#   R2_ACCOUNT_ID  Cloudflare > R2 > la barre laterale droite, "Account ID"
#   R2_BUCKET      le nom de ton bucket
#   les 2 cles     Cloudflare > R2 > API > "Manage API tokens" > Create API token
#                  (permission "Object Read & Write" sur ce bucket)

export R2_ACCOUNT_ID=
export R2_BUCKET=
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
